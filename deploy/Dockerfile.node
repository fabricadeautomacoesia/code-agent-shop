FROM node:20-alpine

WORKDIR /app

ARG SVC=gateway
ENV SVC=${SVC}

# Copia o monorepo inteiro
COPY package.json package-lock.json* ./
COPY packages ./packages
COPY services ./services
COPY bin ./bin
COPY db ./db

# Instala TODAS as deps do workspace + raiz
RUN npm install --no-audit --no-fund --include-workspace-root

# Sem HEALTHCHECK (Swarm usa replicas/restart_policy)
# Apps individuais podem ter /health (Node) ou /api/status (gateway)

WORKDIR /app/services/${SVC}
CMD ["node", "src/server.js"]
