FROM node:20-alpine

WORKDIR /app

ARG SVC=gateway
ENV SVC=${SVC}

# Copia o monorepo inteiro
COPY package.json package-lock.json* ./
COPY packages ./packages
COPY services ./services
COPY bin ./bin
COPY db ./db

# Instala TODAS as deps do workspace + raiz (inclui dotenv da raiz)
RUN npm install --no-audit --no-fund --include-workspace-root

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:$PORT/health 2>/dev/null || exit 1

WORKDIR /app/services/${SVC}
CMD ["node", "src/server.js"]
