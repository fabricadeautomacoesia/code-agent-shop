# ============================================================
# CODE & AGENT SHOP - VARIAVEIS DE AMBIENTE
# Copie para .env e preencha. NUNCA commitar .env real.
# ============================================================

# ---------- AMBIENTE ----------
NODE_ENV=development
APP_NAME=code-agent-shop
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
SELLER_URL=http://localhost:3003

# ---------- PORTAS DOS MICROSSERVICOS ----------
PORT_GATEWAY=3002
PORT_AUTH=3010
PORT_SELLER=3011
PORT_PRODUCT=3012
PORT_QA=3013
PORT_QA_WORKER=3014
PORT_ORDER=3015
PORT_PAYMENT=3016
PORT_REVIEW=3017
PORT_NOTIFICATION=3018
PORT_SEARCH=3019
PORT_VAULT=3020
PORT_AIOPS=3006

# ---------- POSTGRESQL ----------
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=codeshop
PG_PASS=changeme_strong_password_2026
PG_DB=code_agent_shop
PG_POOL_MAX=20
PG_POOL_IDLE_TIMEOUT=30000

# ---------- REDIS (cache + sessions + queue) ----------
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=cas:

# ---------- JWT DUPLO ----------
JWT_ACCESS_SECRET=GERAR_64_CHARS_RANDOM_HEX
JWT_REFRESH_SECRET=GERAR_OUTRO_64_CHARS_RANDOM_HEX
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ---------- COFRE AES-256 (encrypt API keys do seller Classe B) ----------
VAULT_AES_KEY=GERAR_32_BYTES_HEX_64_CHARS
VAULT_AES_IV_LENGTH=16

# ---------- 2FA TOTP ----------
TOTP_ISSUER=CodeAgentShop
TOTP_WINDOW=1

# ---------- FAIL2BAN ----------
FAIL2BAN_MAX_ATTEMPTS=5
FAIL2BAN_BAN_DURATION_MS=900000

# ---------- TAKE RATE ----------
PLATFORM_TAKE_RATE=0.18

# ---------- SLA CLASSE B ----------
SLA_CLASS_B_DAYS=15
SLA_WARNING_DAYS=7,3,1

# ---------- ASAAS ----------
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_API_KEY=PREENCHER_CHAVE_PRODUCAO_OU_SANDBOX
ASAAS_WALLET_PLATAFORMA=ID_WALLET_DA_PLATAFORMA
ASAAS_WEBHOOK_SECRET=GERAR_RANDOM_64_CHARS

# ---------- LLM FALLBACK (snippet 23.7) ----------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_MS=60000

# ---------- QA PIPELINE ----------
QA_CONFIDENCE_THRESHOLD=0.80
QA_MAX_FILE_SIZE_MB=50
N8N_WEBHOOK_URL=https://n8n.exemplo.com/webhook/qa-pipeline
N8N_WEBHOOK_SECRET=GERAR_RANDOM

# ---------- MAIL (nodemailer) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=fabricadeautomacoes0@gmail.com
SMTP_PASS=APP_PASSWORD_GOOGLE
SMTP_FROM="Code & Agent Shop <no-reply@code-agent-shop.com>"

# ---------- WHATSAPP (Evolution API - opcional) ----------
EVOLUTION_API_URL=https://evolution.exemplo.com
EVOLUTION_API_TOKEN=PREENCHER
EVOLUTION_INSTANCE=codeshop

# ---------- AIOPS / ALERTAS ----------
TELEGRAM_BOT_TOKEN=PREENCHER
TELEGRAM_CHAT_ID=PREENCHER
ALERT_CPU_THRESHOLD=85
ALERT_RAM_THRESHOLD=90
ALERT_DISK_THRESHOLD=90
AUTOHEAL_RAM_THRESHOLD=95

# ---------- STORAGE (uploads de produtos) ----------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/var/lib/docker/volumes/node_datad/_data/code-agent-shop/uploads
# se for S3:
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------- GATEWAY RATE LIMIT ----------
GATEWAY_RATE_LIMIT_WINDOW_MS=60000
GATEWAY_RATE_LIMIT_MAX=200

# ---------- LOGGING ----------
LOG_LEVEL=info
LOG_MASK_SECRETS=true
